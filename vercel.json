{
  "buildCommand": "node scripts/compile-shared.cjs && pnpm --filter @workspace/kriczky-virtus build",
  "outputDirectory": "artifacts/kriczky-virtus/dist/public",
  "framework": "vite",
  "redirects": [
    {
      "source": "/ig",
      "destination": "/tools/reinvest-harvest?utm_source=instagram&utm_campaign=bio-link",
      "permanent": false
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/engage-giveaway-2026-flyer", "destination": "/engage-giveaway-2026.html" },
    { "source": "/acq-vantage-bonus-flyer", "destination": "/acq-vantage-bonus-flyer.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
