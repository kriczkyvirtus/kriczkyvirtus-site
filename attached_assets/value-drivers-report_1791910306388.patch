+  </span>
+);
+
+const Steps = ({ steps }) => steps.map((st, i) => (
+  <div key={st.t} style={{ display: "flex", gap: 18, alignItems: "flex-start", padding: "8px 0", borderBottom: i < steps.length - 1 ? `1px solid ${L.ruleLight}` : "none" }}>
